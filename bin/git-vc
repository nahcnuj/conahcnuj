#!/usr/bin/env bash
# git vc — verified commit (git subcommand form).
# Mirrors the `alias.vc` that the plugin injects, so `git vc` works even
# outside an opencode session (plain shell, CI, graders). Delegates to
# gh-app/api-commit.sh, which auto-detects owner/repo/branch.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GH_APP_DIR="${HERE}/../gh-app"
if [[ ! -d "${GH_APP_DIR}" ]]; then
  # Fall back to a sibling gh-app next to the script (installed layout).
  GH_APP_DIR="${HERE}/gh-app"
fi
exec bash "${GH_APP_DIR}/api-commit.sh" "$@"
