# GitHub App settings. Copy this file to app.env (gitignored) and fill in the
# real values; a placeholder keeps the platform default in effect.
APP_ID="<your-app-id>"
INSTALLATION_ID="<your-installation-id>"
APP_SLUG="<your-app-name>"
# Absolute path to the App private key (PEM). ~ is expanded.
PRIVATE_KEY_PATH="<your-priv-key-path>"
# bash that runs the git credential helper. Leave the placeholder to use the
# platform default: Git for Windows under MSYS/MinGW (a plain `bash` resolves
# to WSL there), /bin/bash elsewhere.
BASH_EXE="<your-bash-exe>"
