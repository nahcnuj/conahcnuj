APP_ID="<your-app-id>"
# GitHub ユーザー `conahcnuj[bot]` のアカウント ID。
# APP_ID（GitHub App 自体の ID＝JWT の iss）とは別物。空欄OK:
# 未設定時は公開 API から自動解決する（`gh-app/bot-user-id.sh`）。
# 手動設定する場合の取得方法: gh api users/conahcnuj%5Bbot%5D --jq .id
BOT_USER_ID=
INSTALLATION_ID="<your-installation-id>"
APP_SLUG=conahcnuj
PRIVATE_KEY_PATH="${HOME}/.ssh/conahcnuj.private-key.pem"
BASH_EXE="C:/Program Files/Git/bin/bash.exe"
