APP_ID="<your-app-id>"
# IMPORTANT: This must be the installation ID for the SPECIFIC REPOSITORY (or org/user)
# where you want to create commits. Install the GitHub App on that repo first,
# then get the installation ID from the URL:
# https://github.com/settings/apps/<app-slug>/installations/<installation-id>
INSTALLATION_ID="<your-installation-id>"
APP_SLUG=conahcnuj
# Private key path: use forward slashes and no ~ for cross-platform compatibility
# Windows Git Bash: /c/Users/username/.ssh/key.pem
# Linux/macOS: ~/.ssh/key.pem or /home/user/.ssh/key.pem
PRIVATE_KEY_PATH="${HOME}/.ssh/conahcnuj.private-key.pem"
BASH_EXE="C:/Program Files/Git/bin/bash.exe"
