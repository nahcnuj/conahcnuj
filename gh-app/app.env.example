APP_ID="<your-app-id>"
INSTALLATION_ID="<your-installation-id>"
APP_SLUG="<your-app-name>"
PRIVATE_KEY_PATH="<your-priv-key-path>"
BASH_EXE="<your-bash-exe>"
# Where abnormal exits file their bug report issue (the conahcnuj repository).
# When unset, the driver falls back to the origin remote of its own checkout.
CONAHCNUJ_BUG_REPO="<your-owner>/<your-conahcnuj-repo>"
