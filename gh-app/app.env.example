APP_ID="<your-app-id>"
# GitHub ユーザー `conahcnuj[bot]` のアカウント ID（必須）。
# APP_ID（GitHub App 自体の ID＝JWT の iss）とは別物で、フォールバックは無い。
# 未設定だとプラグイン起動時・setup-git.sh がエラーになる。取得方法:
#   gh api users/conahcnuj%5Bbot%5D --jq .id
BOT_USER_ID="<your-bot-user-id>"
INSTALLATION_ID="<your-installation-id>"
APP_SLUG=conahcnuj
PRIVATE_KEY_PATH="${HOME}/.ssh/conahcnuj.private-key.pem"
BASH_EXE="C:/Program Files/Git/bin/bash.exe"
