APP_ID="<your-app-id>"
# NOTE: BOT_USER_ID はここに書かない（公開 API から自動解決される）。
# 手動で上書きする場合のみ BOT_USER_ID=<bot user id> を追加する。
# APP_ID（GitHub App 自体の ID＝JWT の iss）を代わりに入れてはならない。
INSTALLATION_ID="<your-installation-id>"
APP_SLUG=conahcnuj
PRIVATE_KEY_PATH="${HOME}/.ssh/conahcnuj.private-key.pem"
BASH_EXE="C:/Program Files/Git/bin/bash.exe"
