{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "* --force*": "ask",
      "git push --force origin ma*": "deny",
      "git push -f origin ma*": "deny",
      "*gh-app/app.env*": "deny",
      "git config --global --add*": "deny",
      "git config --global --set*": "deny",
      "git config --global --unset*": "deny",
      "git config --global --remove-section*": "deny"
    },
    "external_directory": {
      "*": "allow"
    },
    "doom_loop": "allow"
  }
}